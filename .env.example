# Authentification de l'application Streamlit (Obligatoire)
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_secure_password

# Clé API OpenRouter pour l'Agent Relecteur
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Configuration Ollama local (Optionnel)
OLLAMA_HOST=http://localhost:11434

# Configuration SMTP (Optionnel, requis pour l'envoi réel)
MODE_SIMULATION=True
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@domain.com
SMTP_PASSWORD=your_app_password